<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ClueDo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ClueDo"
    xmlns:v="clr-namespace:ClueDo.Views"
    Title="ClueDo"
    Shell.BackgroundColor="#003c00"
    Shell.FlyoutBehavior="Disabled"
    Shell.TitleColor="White"
    Shell.TabBarBackgroundColor="#003c00"
    Shell.TabBarTitleColor="White"
    Shell.TabBarForegroundColor="#E4BD40"
    Shell.TabBarUnselectedColor="White">

    <TabBar>
        <Tab Title="Home Page" Icon="home.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>
        <Tab Title="Friends" Icon="friends.png">
            <ShellContent ContentTemplate="{DataTemplate v:FriendsPage}"/>
        </Tab>
        <Tab Title="Rules" Icon="rules.png">
            <ShellContent ContentTemplate="{DataTemplate v:RulesPage}"/>
        </Tab>
    </TabBar>
</Shell>
