<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClueDo.Views.CheckPopup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Color="Transparent">
    <Frame Padding="20"
       CornerRadius="20"
       BackgroundColor="#003c00"
       VerticalOptions="Center"
       HorizontalOptions="Center"
       WidthRequest="250">
        <VerticalStackLayout Spacing="12">
            <Label Text="Check"
                   FontFamily="ClueFont"
                   TextColor="#E4BD40"
                   FontSize="30"/>
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                <Label Grid.Row="0" Text="Room" TextColor="White" FontFamily="ClueFont" />
                <Label Text="{Binding RoomMark}" TextColor="{Binding RoomColor}" Grid.Row="0"
                       Grid.Column="1" FontSize="18" />

                <Label Grid.Row="1" Text="Weapon" TextColor="White" FontFamily="ClueFont" />
                <Label  Text="{Binding WeaponMark}" TextColor="{Binding WeaponColor}" Grid.Row="1"
                        Grid.Column="1" FontSize="18" />

                <Label Grid.Row="2" Text="Suspect" TextColor="White" FontFamily="ClueFont" />
                <Label Text="{Binding SuspectMark}" TextColor="{Binding SuspectColor}" Grid.Row="2"
                       Grid.Column="1" FontSize="18" />
            </Grid>
            <Button
                Text="OK"
                Command="{Binding CloseCommand}"
                BackgroundColor="#E4BD40"/>
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>