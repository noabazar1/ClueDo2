<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ClueDo.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    Title="GamePage"
    x:DataType="vm:GamePageVM"
    BackgroundImageSource="background.jpg">
    <VerticalStackLayout>
        <Label HorizontalOptions="Center" Text="{Binding Player1}" FontFamily="ClueFont" TextColor="White"/>
        <Label HorizontalOptions="Center" Text="{Binding Player2}" FontFamily="ClueFont" TextColor="White"/>
        <Label HorizontalOptions="Center" Text="{Binding Player3}" FontFamily="ClueFont" TextColor="White"/>
        <Label HorizontalOptions="Center" Text="{Binding Player4}" FontFamily="ClueFont" TextColor="White"/>
        <Label HorizontalOptions="Center" Text="{Binding Player5}" FontFamily="ClueFont" TextColor="White"/>
        <Label HorizontalOptions="Center" Text="{Binding StatusMessage}" Margin="20" FontFamily="ClueFont" TextColor="White"/>
        <Grid 
            x:Name="grdBoard" 
            HorizontalOptions="Center" 
            VerticalOptions="Center"
        />
        <Label HorizontalOptions="Center" Text="{Binding MyName}" FontFamily="ClueFont" TextColor="White"/>
    </VerticalStackLayout>
</ContentPage>