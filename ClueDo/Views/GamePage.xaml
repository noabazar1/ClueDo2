<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ClueDo.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    Title=""
    x:DataType="vm:GamePageVM"
    BackgroundImageSource="background.jpg"
    Shell.TabBarIsVisible="False">
    <VerticalStackLayout BackgroundColor="Transparent">
        <Grid 
            x:Name="grdOponnents" 
            HorizontalOptions="Center"/>
        <Label/>
        <Label
            FontFamily="ClueFont"
            HorizontalOptions="Center"
            Text="{Binding StatusMessage}"
            IsVisible="{Binding IsStarted}"
            TextColor="White" />
        <Grid
    x:Name="BoardContainer"
    HorizontalOptions="Center"
    VerticalOptions="Center">
            <Image
        x:Name="imgBoard"
        Source="board.png"
        Aspect="AspectFit" />

            <Grid x:Name="grdBoard"
                  Margin="0, 0, 0, 0"
                  RowSpacing="0"
                  ColumnSpacing="0"
          HorizontalOptions="Fill"
          VerticalOptions="Fill" />
        </Grid>

        <Label
            FontFamily="ClueFont"
            HorizontalOptions="Center"
            Text="{Binding MyName}"
            TextColor="White" />
        <ImageButton
            Source="{Binding DiceImage}"
            BackgroundColor="#E4BD40"
            WidthRequest="110"
            HeightRequest="110"
            CornerRadius="70"
            Padding="0"
            Margin="5"
            Aspect="AspectFit"
            Command="{Binding RollDiceCommand}"
            Opacity="1">
            <ImageButton.Shadow>
                <Shadow
                    Brush="Black"
                    Opacity="0.8"
                    Radius="18"
                    Offset="5,5" />
            </ImageButton.Shadow>
        </ImageButton>
        <Label
            Margin="5"
            FontFamily="ClueFont"
            FontSize="17"
            HorizontalOptions="Center"
            Text="{Binding DiceResult}"
            TextColor="White" />
        <Button Text="Start Game"
                FontFamily="ClueFont"
                BackgroundColor="#E4BD40"
                IsVisible="{Binding IsStartButtonVisible}"
                IsEnabled="{Binding IsStarted, Converter={StaticResource invertBoolConvert}}"
                Command="{Binding StartGameCommand}"/>
    </VerticalStackLayout>
</ContentPage>