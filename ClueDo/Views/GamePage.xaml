<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ClueDo.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    Title="GamePage"
    x:DataType="vm:GamePageVM">
    <VerticalStackLayout>
        <Label HorizontalOptions="Center" Text="{Binding Player1}"/>
        <Label HorizontalOptions="Center" Text="{Binding Player2}"/>
        <Label HorizontalOptions="Center" Text="{Binding Player3}"/>
        <Label HorizontalOptions="Center" Text="{Binding Player4}"/>
        <Label HorizontalOptions="Center" Text="{Binding Player5}"/>
        <Label HorizontalOptions="Center" Text="{Binding MyName}"/>
    </VerticalStackLayout>
</ContentPage>