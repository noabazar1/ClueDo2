<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ClueDo.Views.GamePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    Title="GamePage"
    x:DataType="vm:GamePageVM"
    BackgroundImageSource="background.jpg">
    <VerticalStackLayout>
        <Grid 
            x:Name="grdBoard" 
            HorizontalOptions="Center" 
            VerticalOptions="Center"
        />
        <Label HorizontalOptions="Center" Text="{Binding MyName}" FontFamily="ClueFont" TextColor="White"/>
        <Button
            Text="Roll Dice"
            BackgroundColor="#E4BD40"
            CornerRadius="360"
            FontFamily="ClueFont"
            TextColor="White"
            Command="{Binding RollDiceCommand}">
                <Button.Shadow>
                    <Shadow Brush="Black"
                        Offset="5,5"
                        Opacity="0.8"
                        Radius="18"/>
                </Button.Shadow>
        </Button>
        <Label
            Text="{Binding DiceResult}"
            FontFamily="ClueFont"
            TextColor="White"
            HorizontalOptions="Center"
            FontSize="17"
            Margin="5"/>
    </VerticalStackLayout>
</ContentPage>