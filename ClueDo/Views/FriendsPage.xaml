<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ClueDo.ViewModels"
             x:Class="ClueDo.Views.FriendsPage"
             Title="Friends"
             BackgroundImageSource="background.jpg"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout>
        <Label Text="FRIENDS"
               FontFamily="ClueFont"
               TextColor="White"
               HorizontalOptions="Center"
               FontSize="30"/>
        <Button
            Text="Add Friend"
            Command="{Binding AddFriendCommand}"
            FontFamily="ClueFont"
            BackgroundColor="#E4BD40"/>
        <CollectionView ItemsSource="{Binding Contacts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BackgroundColor="#003c00">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}"
                                   TextColor="White"
                                   FontFamily="ClueFont"
                                   FontSize="20"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>