<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:v="clr-namespace:ClueDo.ViewModels"
             xmlns:m="clr-namespace:ClueDo.Models"
             x:Class="ClueDo.Views.FriendsPage"
             Title="Friends"
             BackgroundImageSource="background.jpg"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout>
        <Label Text="FRIENDS"
               FontFamily="ClueFont"
               TextColor="White"
               HorizontalOptions="Center"
               FontSize="30"/>
        <Button
            Text="Add Friend"
            Command="{Binding AddFriendCommand}"
            FontFamily="ClueFont"
            BackgroundColor="#E4BD40"/>
        <CollectionView ItemsSource="{Binding Contacts}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="10" Margin="5" BackgroundColor="#003c00">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                Text="{Binding Name}"
                                TextColor="White"
                                FontFamily="ClueFont"
                                FontSize="20"
                                VerticalOptions="Center"/>
                            <Button Grid.Column="1"
                                Text="{x:Static m:Keys.X}"
                                WidthRequest="35"
                                HeightRequest="35"
                                Padding="0"
                                FontSize="24"
                                BorderColor="White"
                                BorderWidth="1"
                                BackgroundColor="DarkRed"
                                TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteFriendCommand}"
                                CommandParameter="{Binding .}"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>