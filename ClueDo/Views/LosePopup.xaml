<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClueDo.Views.LosePopup"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             Color="Transparent">
    <Frame Padding="20"
        CornerRadius="20"
        BackgroundColor="#003c00"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        WidthRequest="250">
        <VerticalStackLayout>
            <Label Text="GAME OVER"
               TextColor="#E4BD40"
               FontFamily="ClueFont"
               FontSize="30"/>
            <Label Text="Better Luck Next Time!"
               TextColor="White"
               FontFamily="ClueFont"
               FontSize="15"/>
            <Button Text="Back to main page"
                Clicked="OnBackClicked"
                FontFamily="ClueFont"
                Margin="5"
                BackgroundColor="#E4BD40"/>
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup> 