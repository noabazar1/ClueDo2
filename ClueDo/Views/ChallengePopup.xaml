<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="ClueDo.Views.ChallengePopup"
    Color="Transparent">

    <Frame
        Padding="20"
        CornerRadius="20"
        BackgroundColor="#003c00"
        VerticalOptions="Center"
        HorizontalOptions="Center"
        WidthRequest="250"
        HeightRequest="270">
        <VerticalStackLayout>
            <Label Text="Emergency!"
               FontSize="20"
               FontFamily="ClueFont"
               HorizontalOptions="Center"
               TextColor="#E4BD40"
               Padding="5"/>
            <Label 
                Text="{Binding TimerText}"
                TextColor="White"
                FontSize="25"
                FontFamily="ClueFont"
                HorizontalOptions="Center" />

            <Label 
                Text="Press 20 times in 10 seconds!"
                TextColor="White"
                FontFamily="ClueFont"
                HorizontalOptions="Center"/>

            <Label 
                Text="{Binding CounterText}"
                TextColor="White"
                FontSize="18"
                FontFamily="ClueFont"
                HorizontalOptions="Center"/>

            <Button 
                BackgroundColor="Red"
                HeightRequest="75"
                WidthRequest="75"
                CornerRadius="360"
                Command="{Binding ClickCommand}"/>
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>