<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="ClueDo.Views.AuthPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:ClueDo.Models"
    xmlns:s="c:\vs\clue\cluedo\resources\styles\mystyles.xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    x:DataType="vm:AuthPageVM"
    BackgroundImageSource="background.jpg"
    IsBusy="{Binding IsBusy}">
    <VerticalStackLayout
        Padding="7"
        HorizontalOptions="Center"
        Spacing="10"
        VerticalOptions="Center">
        <Frame
            BackgroundColor="#003c00"
            CornerRadius="20"
            HeightRequest="450"
            WidthRequest="400">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <Label
                    Margin="15"
                    FontAttributes="Bold"
                    FontFamily="ClueFont"
                    FontSize="40"
                    HorizontalOptions="Center"
                    Text="{Binding UserStateAction}"
                    TextColor="White" />
                <Grid
                    Grid.Row="1"
                    Margin="15,0,15,25"
                    IsVisible="{Binding IsRegistered, Converter={StaticResource invertBoolConvert}}">
                    <Border>
                        <Entry
                            BackgroundColor="White"
                            FontFamily="ClueFont"
                            Placeholder="{x:Static m:Strings.Name}"
                            Text="{Binding Name}"
                            TextColor="Black" />
                    </Border>
                </Grid>
                <Grid Grid.Row="2" Margin="15,0,15,25">
                    <Border>
                        <Entry
                            BackgroundColor="White"
                            FontFamily="ClueFont"
                            Keyboard="Email"
                            Placeholder="{x:Static m:Strings.Email}"
                            Text="{Binding Email}"
                            TextColor="Black" />
                    </Border>
                </Grid>
                <Grid Grid.Row="3" Margin="15,0,15,25">
                    <Border>
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Entry
                                BackgroundColor="White"
                                FontFamily="ClueFont"
                                IsPassword="{Binding IsPassword}"
                                Placeholder="{x:Static m:Strings.Password}"
                                ReturnType="Done"
                                Text="{Binding Password}"
                                TextColor="Black" />
                            <Button
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                Command="{Binding ToggleIsPasswordCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="24"
                                HorizontalOptions="End"
                                Text="{Binding IsPassword, Converter={StaticResource passwordIconConvert}}"
                                TextColor="Olive"
                                VerticalOptions="Center"
                                WidthRequest="80" />
                        </Grid>
                    </Border>
                </Grid>
                <Button
                    Grid.Row="4"
                    Margin="15,0,15,0"
                    BackgroundColor="#E4BD40"
                    Command="{Binding AuthCommand}"
                    CornerRadius="8"
                    FontFamily="ClueFont"
                    FontSize="18"
                    HeightRequest="50"
                    Text="{Binding UserStateAction}"
                    TextColor="White">
                    <Button.Shadow>
                        <Shadow
                            Brush="Black"
                            Opacity="0.8"
                            Radius="18"
                            Offset="5,5" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </Frame>
    </VerticalStackLayout>
</ContentPage>