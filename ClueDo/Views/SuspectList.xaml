<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ClueDo.Views.SuspectList"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ClueDo.ViewModels"
    Title="SuspectList"
    x:DataType="vm:SuspectListVM">
    <HorizontalStackLayout Spacing="10" Padding="10">

        <Label
                    Text="{Binding Name}"
                    FontSize="18"
                    VerticalOptions="Center" />

        <Button
                    Text="❌"
                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SuspectListVM}}, Path=ToggleMarkCommand}"
                    CommandParameter="{Binding}"
                    BackgroundColor="Transparent" />

    </HorizontalStackLayout>
</ContentPage>